[
 {
  "text": "Tujuh puluh kapal perang",
  "start": 0.52,
  "end": 1.74
 },
 {
  "text": "dipindah lewat darat,",
  "start": 1.95,
  "end": 3.18
 },
 {
  "text": "dalam satu malam.",
  "start": 3.24,
  "end": 4.5
 },
 {
  "text": "Dan tidak ada",
  "start": 4.64,
  "end": 5.38
 },
 {
  "text": "yang melihatnya datang.",
  "start": 5.4,
  "end": 6.6
 },
 {
  "text": "April seribu empat ratus",
  "start": 6.84,
  "end": 8.58
 },
 {
  "text": "lima puluh tiga.",
  "start": 8.67,
  "end": 9.95
 },
 {
  "text": "Sultan Mehmed yang kedua",
  "start": 10.04,
  "end": 11.28
 },
 {
  "text": "mengepung Konstantinopel.",
  "start": 11.35,
  "end": 12.92
 },
 {
  "text": "Tapi ada satu masalah.",
  "start": 13.34,
  "end": 14.96
 },
 {
  "text": "Mulut Tanduk Emas",
  "start": 15.38,
  "end": 16.61
 },
 {
  "text": "ditutup rantai besi raksasa.",
  "start": 16.63,
  "end": 18.84
 },
 {
  "text": "Kapal Ottoman",
  "start": 18.98,
  "end": 19.68
 },
 {
  "text": "tidak bisa masuk.",
  "start": 19.7,
  "end": 21.14
 },
 {
  "text": "Lalu Sultan punya ide",
  "start": 21.5,
  "end": 22.72
 },
 {
  "text": "yang kedengarannya gila.",
  "start": 22.74,
  "end": 24.36
 },
 {
  "text": "Kalau lautnya ditutup,",
  "start": 24.52,
  "end": 25.98
 },
 {
  "text": "kapalnya pindah",
  "start": 26.08,
  "end": 27.3
 },
 {
  "text": "lewat darat.",
  "start": 27.48,
  "end": 28.26
 },
 {
  "text": "Kapal-kapal itu",
  "start": 28.29,
  "end": 28.92
 },
 {
  "text": "diangkat ke darat,",
  "start": 28.94,
  "end": 30.58
 },
 {
  "text": "ditaruh di atas jalan kayu",
  "start": 30.6,
  "end": 31.94
 },
 {
  "text": "yang dilumuri lemak,",
  "start": 31.96,
  "end": 33.37
 },
 {
  "text": "lalu ditarik naik bukit.",
  "start": 33.42,
  "end": 35.16
 },
 {
  "text": "Jalannya sepuluh kilometer,",
  "start": 35.45,
  "end": 37.24
 },
 {
  "text": "dari pesisir Bosporus",
  "start": 37.36,
  "end": 38.66
 },
 {
  "text": "sampai ke Tanduk Emas.",
  "start": 38.68,
  "end": 40.82
 },
 {
  "text": "Ratusan lembu",
  "start": 40.84,
  "end": 41.54
 },
 {
  "text": "dan ribuan orang",
  "start": 41.56,
  "end": 42.46
 },
 {
  "text": "menariknya,",
  "start": 42.48,
  "end": 43.62
 },
 {
  "text": "pelan-pelan, semalaman.",
  "start": 43.85,
  "end": 45.44
 },
 {
  "text": "Pagi harinya,",
  "start": 45.82,
  "end": 46.78
 },
 {
  "text": "penjaga kota bangun,",
  "start": 46.8,
  "end": 47.98
 },
 {
  "text": "dan melihat tujuh puluh kapal",
  "start": 48.02,
  "end": 49.5
 },
 {
  "text": "sudah berlayar",
  "start": 49.52,
  "end": 50.26
 },
 {
  "text": "di dalam Tanduk Emas.",
  "start": 50.28,
  "end": 52.0
 },
 {
  "text": "Rantai besinya masih utuh.",
  "start": 52.1,
  "end": 53.6
 },
 {
  "text": "Tapi sudah",
  "start": 53.72,
  "end": 54.3
 },
 {
  "text": "tidak ada gunanya.",
  "start": 54.32,
  "end": 55.62
 },
 {
  "text": "Untungnya rantainya",
  "start": 56.28,
  "end": 57.36
 },
 {
  "text": "tidak putus.",
  "start": 57.38,
  "end": 58.34
 },
 {
  "text": "Sayangnya, musuhnya",
  "start": 58.6,
  "end": 59.94
 },
 {
  "text": "sudah di belakang rantai.",
  "start": 59.96,
  "end": 61.58
 },
 {
  "text": "Rahasianya gesekan.",
  "start": 62.15,
  "end": 63.76
 },
 {
  "text": "Kayu yang dilumuri lemak",
  "start": 63.91,
  "end": 65.18
 },
 {
  "text": "itu licin,",
  "start": 65.2,
  "end": 66.26
 },
 {
  "text": "jadi kapal seberat",
  "start": 66.38,
  "end": 67.22
 },
 {
  "text": "puluhan ton",
  "start": 67.24,
  "end": 67.88
 },
 {
  "text": "bisa meluncur.",
  "start": 67.9,
  "end": 68.94
 },
 {
  "text": "Sama seperti mendorong",
  "start": 69.36,
  "end": 70.24
 },
 {
  "text": "lemari berat",
  "start": 70.26,
  "end": 71.0
 },
 {
  "text": "di lantai yang licin.",
  "start": 71.02,
  "end": 72.48
 },
 {
  "text": "Begitu bergerak,",
  "start": 72.75,
  "end": 73.6
 },
 {
  "text": "dia jalan sendiri.",
  "start": 73.72,
  "end": 74.96
 },
 {
  "text": "Sebulan kemudian,",
  "start": 75.52,
  "end": 76.5
 },
 {
  "text": "tanggal dua puluh sembilan Mei,",
  "start": 76.56,
  "end": 78.39
 },
 {
  "text": "kotanya jatuh.",
  "start": 78.41,
  "end": 79.5
 },
 {
  "text": "Kalau kamu jadi panglima Bizantium,",
  "start": 79.74,
  "end": 81.65
 },
 {
  "text": "kamu jaga rantai,",
  "start": 81.74,
  "end": 82.88
 },
 {
  "text": "atau jaga bukit?",
  "start": 82.9,
  "end": 83.6
 },
 {
  "text": "Tulis A atau B",
  "start": 83.62,
  "end": 85.52
 },
 {
  "text": "di komentar.",
  "start": 85.56,
  "end": 86.18
 }
]